# =============================================================================
# Эталон несекретной конфигурации. bootstrap.sh создаёт из него infra/.env.
# Реальный .env в git не коммитится (.gitignore).
#
# Секретов здесь нет и быть не должно: файл переменных окружения читается
# любым процессом контейнера и попадает в вывод диагностических команд
# (docs/security/security.md, раздел 5). Секреты — отдельные файлы
# в infra/secrets/. Их генерирует bootstrap.sh, а в контейнеры они попадают
# механизмом Docker secrets. Перечень — infra/README.md, раздел «Секреты».
#
# ADR-0001: локальный контур. Внешних сервисов генеративного AI здесь нет
# и быть не должно — ни адресов, ни ключей. Проверка соблюдения ADR-0001
# состоит в том числе в отсутствии таких значений в этом файле.
# =============================================================================

COMPOSE_PROJECT_NAME=service-desk-ai
TZ=Europe/Moscow

# -----------------------------------------------------------------------------
# Веса моделей
# -----------------------------------------------------------------------------
# Каталог на хосте, куда скачиваются веса. Вынесен из образов и из docker-томов
# намеренно: сервер прерываемый, но диск переживает перезапуск контейнеров,
# а повторное скачивание ~15 ГБ на каждом старте недопустимо.
MODELS_DIR=/opt/models

# Токен Hugging Face здесь не задаётся: это секрет. Для Qwen и BAAI он
# не нужен (репозитории открытые). При переходе на закрытые веса положить
# токен в infra/secrets/hf_token — его прочитает загрузка весов в bootstrap.sh.

# Зеркало Hugging Face. Пусто = официальный endpoint.
# ПРОВЕРИТЬ НА МАШИНЕ: при недоступности huggingface.co из сети Selectel
# указать https://hf-mirror.com
HF_ENDPOINT=

# -----------------------------------------------------------------------------
# Сервис инференса (vLLM)
# -----------------------------------------------------------------------------
# ПРОВЕРИТЬ НА МАШИНЕ: тег образа. Требования: поддержка Qwen3 (с v0.8.5),
# Qwen2.5-VL AWQ и режима embed. Проверить актуальный тег на
# https://hub.docker.com/r/vllm/vllm-openai/tags и зафиксировать здесь.
VLLM_IMAGE=vllm/vllm-openai:v0.9.2

# Общий ключ трёх эндпоинтов vLLM — секрет infra/secrets/vllm_api_key.
# Ключ настоящий: контур закрытый, но сервисы не должны быть анонимными
# (docs/security/security.md, раздел 5).

# --- Языковая модель (ADR-0005, workspace.dsl) ---
LLM_MODEL_ID=Qwen/Qwen3-8B-AWQ
# Immutable SHA весов; проверен по кэшу демонстрационного узла.
LLM_MODEL_REVISION=4da05a8edb55c6046cce958586c33b61da07bb79
LLM_SERVED_NAME=qwen3-8b
LLM_PORT=8001
LLM_MAX_MODEL_LEN=32768
# Доля видеопамяти всей карты (48 ГБ). Сумма трёх долей должна оставлять запас.
LLM_GPU_FRACTION=0.40

# --- Модель обработки изображений (ADR-0005, workspace.dsl) ---
VISION_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# Immutable SHA весов; проверен по кэшу демонстрационного узла.
VISION_MODEL_REVISION=536a35794df8831aa814970ee8f89eff577e7718
VISION_SERVED_NAME=qwen2.5-vl-7b
VISION_PORT=8002
VISION_MAX_MODEL_LEN=16384
VISION_GPU_FRACTION=0.27
# Табличка на обращение — одна, второе изображение как запас на переснятый кадр.
VISION_MAX_IMAGES=2

# --- Модель векторных представлений (ADR-0003, ADR-0005) ---
# Только плотная ветвь. Разреженная ветвь — BM25 средствами Qdrant, GPU не занимает.
EMBED_MODEL_ID=BAAI/bge-m3
# Immutable SHA весов; проверен по кэшу демонстрационного узла.
EMBED_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBED_SERVED_NAME=bge-m3
EMBED_PORT=8003
EMBED_MAX_MODEL_LEN=8192
EMBED_GPU_FRACTION=0.08

# -----------------------------------------------------------------------------
# Хранилище состояния (PostgreSQL)
# -----------------------------------------------------------------------------
# Схема по docs/architecture/data-model.md: состояние процесса, согласования,
# аудиторский след. Собственный аудит платформы ведётся здесь и не зависит
# от доступности Langfuse.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=servicedesk
POSTGRES_USER=servicedesk
# Пароль — секрет infra/secrets/postgres_password.

# -----------------------------------------------------------------------------
# Векторное хранилище (Qdrant)
# -----------------------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Ключ доступа — секрет infra/secrets/qdrant_api_key.

# Одна коллекция на оба представления — требование ADR-0003:
# фильтр по правам применяется к запросу целиком, а не к одной из ветвей.
QDRANT_COLLECTION=doc_chunks
# Размерность плотного представления bge-m3.
EMBED_DIM=1024
# Язык стемминга и стоп-слов для BM25. Корпус и обращения русскоязычные:
# без этого свободные описания симптомов находятся заметно хуже.
BM25_LANGUAGE=russian

# -----------------------------------------------------------------------------
# Приложение (профиль app)
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
MOCK_ERP_PORT=8100
# Токен доступа к моку — секрет infra/secrets/mock_erp_token.
UI_PORT=8501

# -----------------------------------------------------------------------------
# Наблюдаемость (профиль observability)
# -----------------------------------------------------------------------------
# Langfuse — инструмент разработчика. Приложение работает при его недоступности.
# У Langfuse собственный PostgreSQL: связь с хранилищем состояния отсутствует.
LANGFUSE_PORT=3000
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_USER=langfuse
# Секреты профиля — файлы в infra/secrets/: langfuse_postgres_password,
# langfuse_salt, langfuse_nextauth_secret, langfuse_encryption_key (ровно
# 256 бит в hex — требование Langfuse v3), clickhouse_password,
# redis_password, minio_root_password.

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Пароль администратора — секрет infra/secrets/grafana_admin_password.

# -----------------------------------------------------------------------------
# Поведение bootstrap.sh
# -----------------------------------------------------------------------------
# Блокировать исходящие соединения к внешним сервисам генеративного AI.
# Требование ADR-0001, «Проверка соблюдения»: сетевые правила узла
# не допускают таких соединений. 0 отключает правило.
ENABLE_EGRESS_GUARD=1

# Перезагрузить машину автоматически, если после установки драйвера NVIDIA
# требуется перезапуск. 1 разумно для прерываемого сервера без оператора.
AUTO_REBOOT=0

# Предзагружать веса моделей до старта стека. 0 — модели скачает сам vLLM
# при первом запуске (дольше до готовности, нет отдельного шага).
PREFETCH_MODELS=1

# -----------------------------------------------------------------------------
# Резервное копирование (ADR-0007, «Цели восстановления»)
# -----------------------------------------------------------------------------
# Ежедневная выгрузка базы состояния и аудита. В MVP каталог на системном
# диске узла: выгрузка защищает от потери данных при пересоздании контейнеров
# и повреждении базы, но не переживает пересоздание самого узла. Вынос на
# отдельный сетевой диск отложен и зафиксирован как ограничение MVP
# (docs/architecture/conformance.md, раздел 7). Чтобы вынести: подключить диск
# в панели провайдера, смонтировать по UUID и указать точку монтирования здесь.
BACKUP_DIR=/var/backups/service-desk-ai
BACKUP_KEEP_DAYS=14

# Custom integration service ZAI_SERVICE, реализован отдельным mock ERP.
ERP_BASE_URL=http://mock-erp:8100/sap/opu/odata4/sap/zai_service/0001/
